<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="TimeWarp.State" Version="12.0.0-beta.8" ExcludeAssets="contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FantasyInformator.Domain\FantasyInformator.Domain.csproj" />
    <ProjectReference Include="..\FantasyInformator.Logic\FantasyInformator.Logic.csproj" />
    <ProjectReference Include="..\FantasyInformator.Shared\FantasyInformator.Shared.csproj" />
  </ItemGroup>

</Project>
