@using FantasyInformator.App.Resources
@inherits LayoutComponentBase

@if (IsDatabaseAwake)
{
    @Body
}
else if (IsDatabaseUnavailable)
{
    <p>@Texts.DatabaseUnavailable</p>
}
else
{
    <p>@Texts.WaitingForDatabase</p>
}

<div id="blazor-error-ui" data-nosnippet
     class="fixed bottom-0 left-0 z-1000 box-border hidden w-full bg-[lightyellow] px-5 pt-[0.6rem] pb-[0.7rem]
            shadow-[0_-1px_2px_rgba(0,0,0,0.2)] scheme-only-light">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss absolute top-2 right-3 cursor-pointer">🗙</span>
</div>
