@using TimeWarp.State
@inherits TimeWarpStateComponent

<div class="fixed top-4 right-4 z-950 flex w-80 flex-col gap-2">
    @foreach (var toast in Toasts)
    {
        <div class="cursor-pointer rounded-md px-4 py-3 shadow-lg @toast.ColorClasses" @onclick="() => RemoveToast(toast)">
            <p class="font-bold">@toast.Header</p>
            <p>@toast.Message</p>
        </div>
    }
</div>
